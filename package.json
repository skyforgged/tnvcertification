{
  "name": "tnv-certification",
  "version": "0.1.0",
  "private": true,
  "description": "PT. Intiprima Sertifikasi - website content-driven Astro + TypeScript + Tailwind CSS",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.mjs",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "mdast-util-to-string": "4.0.0",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.0.0",
    "tinyglobby": "0.2.17",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
