{
  "name": "tnv-certification",
  "version": "0.1.0",
  "private": true,
  "description": "PT. Intiprima Sertifikasi - website content-driven Astro + TypeScript + Tailwind CSS",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.mjs",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.0.0",
    "typescript": "7.0.2",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
