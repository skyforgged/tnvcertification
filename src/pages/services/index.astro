---
import Layout from "../../layouts/Layout.astro";
import MainMenuHero from "../../components/MainMenuHero.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { getPublishedArticles, getServiceIndexArticles } from "../../data/articles";
import { siteSettings } from "../../site";
import { serviceIndexJsonLd } from "../../lib/structured-data";
const services = await getCollection("services", ({ data }) => data.draft !== true);
const articles = getServiceIndexArticles(getPublishedArticles());
const structuredData = serviceIndexJsonLd(
  services.map((service) => ({
    name: service.data.title,
    description: service.data.metaDescription,
    path: `/services/${service.data.slug}/`,
  })),
);
---
<Layout title={`Layanan | ${siteSettings.title}`} description="Layanan sertifikasi, pelatihan, dan penilaian kepatuhan." canonical="/services/" lang="id" ogImage="/images/illustrations/services-assessment.webp" structuredData={structuredData}>
  <div class="w-full space-y-12">
    <MainMenuHero
      eyebrow="Layanan profesional"
      title="Layanan Kami"
      description="Layanan sertifikasi, pelatihan, dan penilaian kepatuhan untuk mendukung organisasi dalam meningkatkan mutu, kompetensi, dan keandalan proses."
      image="/images/illustrations/services-assessment.webp"
      imageAlt="Ilustrasi proses asesmen layanan sertifikasi dan evaluasi kepatuhan"
    />
    {services.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="border-t-4 border-brand-orange pt-5">
            <h2 class="text-xl font-semibold text-brand-deepblue"><a href={`/services/${service.data.slug}/`} class="hover:text-brand-blue">{service.data.title}</a></h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{service.data.intro}</p>
          </article>
        ))}
      </div>
    ) : <p>Informasi layanan akan segera tersedia.</p>}
    {articles.length > 0 && (
      <section aria-labelledby="artikel-terbaru-layanan">
        <h2 id="artikel-terbaru-layanan" class="text-2xl font-semibold text-brand-deepblue">Artikel Terbaru</h2>
        <div class="mt-6 grid gap-8 md:grid-cols-3">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
