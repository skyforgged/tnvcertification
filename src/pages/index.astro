---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/HomeHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { siteSettings } from "../site";
import { getHomepageArticles, getPublishedArticles } from "../data/articles";

const articles = getHomepageArticles(getPublishedArticles());
---

<Layout title={siteSettings.title} description={siteSettings.description}>
  <div class="w-full space-y-14">
    <HomeHero title="Sertifikasi dan kepatuhan, dengan informasi yang jelas." description={siteSettings.description} />

    <section class="grid gap-5 sm:grid-cols-2" aria-label="Jelajahi situs">
      <a href="/service/" class="group rounded-2xl border border-brand-blue/15 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-blue/40 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-orange">01 / Layanan</span>
        <h2 class="mt-3 text-xl font-semibold text-brand-deepblue">Informasi layanan</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Lihat informasi layanan dan pembaruan katalog yang tersedia.</p>
        <span class="mt-5 inline-block font-semibold text-brand-blue group-hover:underline">Jelajahi →</span>
      </a>
      <a href="/articles/" class="group rounded-2xl border border-brand-blue/15 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-blue/40 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-orange">02 / Wawasan</span>
        <h2 class="mt-3 text-xl font-semibold text-brand-deepblue">Artikel dan panduan</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Baca materi tentang sertifikasi, sistem manajemen, dan kepatuhan.</p>
        <span class="mt-5 inline-block font-semibold text-brand-blue group-hover:underline">Baca artikel →</span>
      </a>
    </section>

    {articles.length > 0 && (
      <section aria-labelledby="artikel-terbaru">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Wawasan terbaru</p>
            <h2 id="artikel-terbaru" class="mt-2 text-2xl font-semibold tracking-tight text-brand-deepblue">Artikel Terbaru</h2>
          </div>
          <a href="/articles/" class="text-sm font-semibold text-brand-blue underline underline-offset-4">Semua artikel →</a>
        </div>
        <div class="mt-6 grid gap-8 md:grid-cols-3">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
