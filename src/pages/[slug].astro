---
import { getCollection } from "astro:content";
import WidePageLayout from "../layouts/WidePageLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import { getPageHero, getPageBlocks, routeOwnedPageSlugs } from "../data/pages";
import { siteCrumb } from "../data/breadcrumbs";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => data.draft !== true);
  return pages
    .filter((entry) => !routeOwnedPageSlugs.includes(entry.data.slug))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const canonical = `/${entry.data.slug}/`;
const hero = getPageHero(entry);
const blocks = getPageBlocks(entry).filter((block) => block.type !== "hero");
const fallbackImage = { src: entry.data.featuredImage.src, alt: entry.data.featuredImage.alt };
---

<WidePageLayout
  title={entry.data.title}
  description={entry.data.metaDescription}
  lang={entry.data.lang}
  canonical={canonical}
  ogImage={entry.data.featuredImage.src}
>
  <Fragment slot="fullBleed">
    <div class="mx-auto w-full max-w-[var(--container-landing)] px-[var(--page-gutter)] pt-8 sm:pt-10 lg:pt-12">
      <Breadcrumbs
        items={[siteCrumb("/", entry.data.lang), { label: entry.data.title }]}
        lang={entry.data.lang}
      />
    </div>
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} isAbout />}
  </Fragment>
  <article class="w-full">
    <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={entry.data.lang} />
  </article>
</WidePageLayout>
