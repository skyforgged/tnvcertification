---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../layouts/ArticleLayout.astro";
import WidePageLayout from "../layouts/WidePageLayout.astro";
import MainMenuHero from "../components/MainMenuHero.astro";
import Section from "../components/Section.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => data.draft !== true);
  return pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `/${entry.data.slug}/`;
const isAboutPage = entry.data.slug === "about-us";
---

{isAboutPage ? (
  <WidePageLayout
    title={entry.data.title}
    description={entry.data.metaDescription}
    lang={entry.data.lang}
    canonical={canonical}
    ogImage={entry.data.featuredImage.src}
  >
    <MainMenuHero
      eyebrow="Profil organisasi"
      title={entry.data.title}
      description={entry.data.intro}
      image={entry.data.featuredImage.src}
      imageAlt={entry.data.featuredImage.alt}
      imagePriority
    />
    <Section spacing="spacious" class="max-w-3xl">
      <div class="prose"><Content /></div>
    </Section>
  </WidePageLayout>
) : (
  <ArticleLayout
    title={entry.data.title}
    description={entry.data.metaDescription}
    lang={entry.data.lang}
    canonical={canonical}
    ogImage={entry.data.featuredImage.src}
    date={entry.data.updatedDate ?? entry.data.pubDate}
    imageAlt={entry.data.featuredImage.alt}
  >
    <Content />
  </ArticleLayout>
)}
