---
import WidePageLayout from "../../layouts/WidePageLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHero from "../../components/page/PageHero.astro";
import PageBlockRenderer from "../../components/page/PageBlockRenderer.astro";
import {
  CSMS_TOPIC_PREFIX,
  getCsmsTopicEntries,
  getPageBlocks,
  getPageHero,
} from "../../data/pages";
import { siteCrumb } from "../../data/breadcrumbs";

export async function getStaticPaths() {
  const entries = await getCsmsTopicEntries();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug.slice(CSMS_TOPIC_PREFIX.length) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.data.slug.slice(CSMS_TOPIC_PREFIX.length);
const canonical = `/csms/${slug}/`;
const hero = getPageHero(entry);
const blocks = getPageBlocks(entry).filter((block) => block.type !== "hero");
const fallbackImage = { src: entry.data.featuredImage.src, alt: entry.data.featuredImage.alt };
---

<WidePageLayout
  title={`${entry.data.title} | CSMS`}
  description={entry.data.metaDescription}
  canonical={canonical}
  lang={entry.data.lang}
  ogImage={fallbackImage.src}
>
  <Fragment slot="fullBleed">
    <div class="mx-auto w-full max-w-[var(--container-landing)] px-[var(--page-gutter)] pt-8 sm:pt-10 lg:pt-12">
      <Breadcrumbs
        items={[
          siteCrumb("/", entry.data.lang),
          siteCrumb("/csms/", entry.data.lang),
          { label: entry.data.title },
        ]}
        lang={entry.data.lang}
      />
    </div>
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} isCsms />}
  </Fragment>
  <article class="w-full">
    <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={entry.data.lang} />
  </article>
</WidePageLayout>
