---
import { getEnglishFallbackPaths } from "../../data/locale-fallback";
import { siteSettings } from "../../site";

export async function getStaticPaths() {
  const paths = await getEnglishFallbackPaths();
  return paths.map((target) => ({
    params: { path: target.slice(1, -1) },
    props: { target },
  }));
}

const { target } = Astro.props;
const sourcePath = `/en${target}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to: {target}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, siteSettings.url).toString()} />
  </head>
  <body>
    <a href={target}>Redirecting from <code>{sourcePath}</code> to <code>{target}</code></a>
  </body>
</html>
