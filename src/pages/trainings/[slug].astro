---
import { getCollection } from "astro:content";
import TrainingLayout from "../../layouts/TrainingLayout.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TrainingScheduleMonths from "../../components/page/TrainingScheduleMonths.astro";
import { getTrainingView } from "../../data/training-view";
import { sortSchedulesByStartDate } from "../../lib/schedule-display";
import { siteSettings } from "../../site";
import { getPublishedServices, servicePath } from "../../data/services";
import { trainingPageJsonLd } from "../../lib/structured-data";

export async function getStaticPaths() {
  const trainings = await getCollection(
    "training",
    ({ data }) => data.draft !== true && data.lang === "id",
  );
  return trainings.map((training) => ({
    params: { slug: training.data.slug },
    props: { training },
  }));
}

const { training } = Astro.props;
const { hero, blocks } = getTrainingView({
  title: training.data.title,
  blocks: training.data.blocks,
});
const footerDescription = siteSettings.footer.trainingDescription(training.data.title);
const schedules = sortSchedulesByStartDate(
  await getCollection(
    "trainingSchedules",
    ({ data }) =>
      data.trainingSlug === training.data.slug &&
      Boolean(data.startDate) &&
      data.registrationStatus !== "cancelled",
  ),
);
const publishedServices = await getPublishedServices(training.data.lang === "en" ? "en" : "id");
const relatedServiceSlugs = [...new Set([
  ...(training.data.relatedServiceSlugs ?? []),
  ...schedules.map(({ data }) => data.serviceSlug).filter((slug): slug is string => Boolean(slug)),
])];
const relatedServices = relatedServiceSlugs.map((slug) => {
  const service = publishedServices.find((item) => item.data.slug === slug);
  if (!service) throw new Error(`Training "${training.data.slug}" references missing or unpublished service "${slug}".`);
  return { name: service.data.title, description: service.data.metaDescription, path: servicePath(service.data) };
});
const structuredData = trainingPageJsonLd({
  name: training.data.title,
  description: training.data.metaDescription,
  path: `/trainings/${training.data.slug}/`,
  image: training.data.featuredImage.src,
  lang: training.data.lang,
  blocks,
  relatedServices,
  schedules: schedules.map(({ data }) => data),
});
const isEnglish = training.data.lang === "en";
const locale = isEnglish ? "en-US" : "id-ID";
const labels = isEnglish
  ? {
      schedule: "Training schedule", online: "Online", hybrid: "Hybrid", offline: "In person",
      locationPending: "Location to be confirmed", open: "Registration open",
      closed: "Registration closed", full: "Fully booked", pending: "Registration details to follow",
      price: "Fee", quota: "Available seats", register: "Register",
      noSchedule: "No published schedule is available for this program yet.",
      datePending: "Schedule to be announced",
      showPast: "Show past sessions",
      summaryActive: "Showing {count} upcoming sessions.",
      summaryAll: "Showing {count} sessions.",
      emptyMonth: "No sessions for the selected month.",
      note: "Schedules may change. Confirm the details before registering.",
      past: "Already passed",
      ongoing: "In progress",
      monthPickerLabel: "Choose a schedule month",
      monthButtonLabel: "{month}, {count} sessions",
    }
  : {
      schedule: "Jadwal pelatihan", online: "Online", hybrid: "Hybrid", offline: "Tatap muka",
      locationPending: "Lokasi menyusul", open: "Pendaftaran dibuka",
      closed: "Pendaftaran ditutup", full: "Kuota terpenuhi", pending: "Informasi pendaftaran menyusul",
      price: "Biaya", quota: "Kuota", register: "Daftar pelatihan",
      noSchedule: "Belum ada jadwal yang dipublikasikan untuk program ini.",
      datePending: "Jadwal akan diumumkan",
      showPast: "Tampilkan jadwal yang sudah lewat",
      summaryActive: "Menampilkan {count} jadwal aktif dan mendatang.",
      summaryAll: "Menampilkan {count} jadwal.",
      emptyMonth: "Tidak ada jadwal untuk bulan yang dipilih.",
      note: "Jadwal dapat berubah. Konfirmasikan kembali informasi pelaksanaan sebelum mendaftar.",
      past: "Sudah terlewati",
      ongoing: "Sedang berlangsung",
      monthPickerLabel: "Pilih bulan jadwal",
      monthButtonLabel: "{month}, {count} jadwal",
    };
const todayKey = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Jakarta", year: "numeric", month: "2-digit", day: "2-digit",
}).format(new Date());
---
<TrainingLayout
  title={`${training.data.title} | Pelatihan | ${siteSettings.title}`}
  description={training.data.metaDescription}
  canonical={`/trainings/${training.data.slug}/`}
  lang={training.data.lang}
  ogImage={training.data.featuredImage.src}
  imageAlt={training.data.featuredImage.alt}
  footerDescription={footerDescription}
  hero={hero}
  blocks={blocks}
  structuredData={structuredData}
>
  <div class="w-full">
    <Section spacing="spacious" aria-labelledby="jadwal-pelatihan">
      <SectionHeading id="jadwal-pelatihan" title={labels.schedule} />
      {schedules.length > 0 ? (
        <TrainingScheduleMonths
          schedules={schedules}
          labels={labels}
          locale={locale}
          todayKey={todayKey}
        />
      ) : (
        <p class="mt-4 max-w-3xl border-y border-border py-6 leading-relaxed text-ink-muted">{labels.noSchedule}</p>
      )}
    </Section>
  </div>
</TrainingLayout>
