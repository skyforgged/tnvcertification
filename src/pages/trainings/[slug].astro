---
import { getCollection } from "astro:content";
import TrainingLayout from "../../layouts/TrainingLayout.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getTrainingView } from "../../data/training-view";
import { scheduleDateLabel, sortSchedulesByStartDate } from "../../lib/schedule-display";
import { siteSettings } from "../../site";

export async function getStaticPaths() {
  const trainings = await getCollection(
    "training",
    ({ data }) => data.draft !== true && data.lang === "id",
  );
  return trainings.map((training) => ({
    params: { slug: training.data.slug },
    props: { training },
  }));
}

const { training } = Astro.props;
const { hero, blocks } = getTrainingView({
  title: training.data.title,
  blocks: training.data.blocks,
});
const schedules = sortSchedulesByStartDate(
  await getCollection(
    "trainingSchedules",
    ({ data }) =>
      data.trainingSlug === training.data.slug &&
      data.registrationStatus !== "cancelled",
  ),
);
const isEnglish = training.data.lang === "en";
const locale = isEnglish ? "en-US" : "id-ID";
const labels = isEnglish
  ? {
      schedule: "Training schedule", online: "Online", hybrid: "Hybrid", offline: "In person",
      locationPending: "Location to be confirmed", open: "Registration open",
      closed: "Registration closed", full: "Fully booked", pending: "Registration details to follow",
      price: "Fee", quota: "Available seats", register: "Register",
      noSchedule: "No published schedule is available for this program yet.",
      datePending: "Schedule to be announced",
    }
  : {
      schedule: "Jadwal pelatihan", online: "Online", hybrid: "Hybrid", offline: "Tatap muka",
      locationPending: "Lokasi menyusul", open: "Pendaftaran dibuka",
      closed: "Pendaftaran ditutup", full: "Kuota terpenuhi", pending: "Informasi pendaftaran menyusul",
      price: "Biaya", quota: "Kuota", register: "Daftar pelatihan",
      noSchedule: "Belum ada jadwal yang dipublikasikan untuk program ini.",
      datePending: "Jadwal akan diumumkan",
    };
const statusLabel = (status?: string) => ({
  open: labels.open, closed: labels.closed, full: labels.full,
}[status ?? ""] ?? labels.pending);
const locationLabel = (type?: string) => ({
  online: labels.online, hybrid: labels.hybrid, offline: labels.offline,
}[type ?? ""] ?? labels.locationPending);
---
<TrainingLayout
  title={`${training.data.title} | Pelatihan | ${siteSettings.title}`}
  description={training.data.metaDescription}
  canonical={`/trainings/${training.data.slug}/`}
  lang={training.data.lang}
  ogImage={training.data.featuredImage.src}
  imageAlt={training.data.featuredImage.alt}
  hero={hero}
  blocks={blocks}
>
  <div class="w-full">
    <Section spacing="spacious" aria-labelledby="jadwal-pelatihan">
      <SectionHeading id="jadwal-pelatihan" title={labels.schedule} />
      {schedules.length > 0 ? (
        <div class="mt-6 divide-y divide-border border-y border-border">
          {schedules.map((schedule) => (
            <article class="grid gap-4 py-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
              <div>
                <h3 class="text-lg font-semibold tracking-tight text-ink">{scheduleDateLabel(schedule.data.startDate, schedule.data.endDate, { locale, pendingLabel: labels.datePending })}</h3>
                <p class="mt-2 text-sm text-ink-muted">{locationLabel(schedule.data.locationType)}</p>
                {(schedule.data.venue || schedule.data.city) && (
                  <p class="mt-1 text-sm text-ink-muted">{[schedule.data.venue, schedule.data.city, schedule.data.province].filter(Boolean).join(", ")}</p>
                )}
                <p class="mt-3 text-sm font-medium text-ink">{statusLabel(schedule.data.registrationStatus)}</p>
                {schedule.data.price !== undefined && (
                  <p class="mt-1 text-sm text-ink-muted">
                    {labels.price}: {schedule.data.currency === "IDR" || !schedule.data.currency ? "Rp " : `${schedule.data.currency} `}
                    {schedule.data.price.toLocaleString(locale)}
                  </p>
                )}
                {schedule.data.quota !== undefined && (
                  <p class="mt-1 text-sm text-ink-muted">{labels.quota}: {schedule.data.quota}</p>
                )}
              </div>
              {schedule.data.registrationUrl && schedule.data.registrationStatus === "open" && (
                <div class="md:justify-self-end">
                  <ButtonLink href={schedule.data.registrationUrl}>{labels.register}</ButtonLink>
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-4 max-w-3xl border-y border-border py-6 leading-relaxed text-ink-muted">{labels.noSchedule}</p>
      )}
    </Section>
  </div>
</TrainingLayout>
