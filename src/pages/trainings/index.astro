---
import WidePageLayout from "../../layouts/WidePageLayout.astro";
import MainMenuHero from "../../components/MainMenuHero.astro";
import TrainingCard from "../../components/TrainingCard.astro";
import Section from "../../components/Section.astro";
import { getCollection } from "astro:content";
import { siteSettings } from "../../site";

const trainings = await getCollection(
  "training",
  ({ data }) => data.draft !== true && data.lang === "id",
);
---
<WidePageLayout
  title={`Pelatihan | ${siteSettings.title}`}
  description="Katalog program pelatihan dan pengembangan kompetensi untuk sistem manajemen, audit, dan kepatuhan."
  canonical="/trainings/"
  lang="id"
  ogImage="/images/illustrations/training-competency.webp"
>
  <div class="w-full">
    <MainMenuHero
      eyebrow="Training &amp; Competency"
      title="Program Pelatihan"
      description="Program pembelajaran untuk membantu organisasi dan profesional memahami persyaratan sistem manajemen, meningkatkan kompetensi, serta mempersiapkan penerapan dan audit."
      image="/images/illustrations/training-competency.webp"
      imageAlt="Ilustrasi pembelajaran profesional, pengembangan kompetensi, dan pelatihan"
    />

    {trainings.length > 0 ? (
      <Section spacing="default" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {trainings.map((training) => (
          <TrainingCard
            title={training.data.title}
            description={training.data.intro}
            href={`/trainings/${training.data.slug}/`}
          />
        ))}
      </Section>
    ) : (
      <Section spacing="default" class="max-w-3xl border-y border-border py-8">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Katalog pelatihan sedang disiapkan</h2>
        <p class="mt-3 leading-relaxed text-ink-muted">
          Informasi program, materi, persyaratan peserta, dan jadwal akan ditampilkan setelah masing-masing program siap dipublikasikan. Jadwal pelaksanaan akan dikelola terpisah dari informasi program agar perubahan tanggal, lokasi, kuota, dan status pendaftaran tetap akurat.
        </p>
      </Section>
    )}
  </div>
</WidePageLayout>
