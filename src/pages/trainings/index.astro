---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { siteSettings } from "../../site";

const trainings = await getCollection(
  "training",
  ({ data }) => data.draft !== true && data.lang === "id",
);
---
<Layout
  title={`Pelatihan | ${siteSettings.title}`}
  description="Katalog program pelatihan dan pengembangan kompetensi untuk sistem manajemen, audit, dan kepatuhan."
  canonical="/trainings/"
  lang="id"
  ogImage="/images/illustrations/training-competency.webp"
>
  <section class="w-full" aria-labelledby="training-index">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Pelatihan" }]} />
    <header class="grid items-center gap-8 md:grid-cols-[1fr_280px]">
      <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-orange">Training &amp; Competency</p>
      <h1 id="training-index" class="mt-3 text-3xl font-semibold tracking-tight text-brand-deepblue sm:text-4xl">Program Pelatihan</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-700">
        Program pembelajaran untuk membantu organisasi dan profesional memahami persyaratan sistem manajemen, meningkatkan kompetensi, serta mempersiapkan penerapan dan audit.
      </p>
      </div>
      <img data-page-image src="/images/illustrations/training-competency.webp alt="" aria-hidden="true" width="640" height="480" loading="lazy" class="mx-auto w-full max-w-[280px]" />
    </header>

    {trainings.length > 0 ? (
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {trainings.map((training) => (
          <article class="rounded-xl border border-brand-blue/15 bg-white p-6">
            <h2 class="text-xl font-semibold text-brand-deepblue">
              <a href={`/trainings/${training.data.slug}/`} class="hover:text-brand-blue">{training.data.title}</a>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{training.data.intro}</p>
            <a href={`/trainings/${training.data.slug}/`} class="mt-5 inline-flex font-semibold text-brand-blue underline underline-offset-4">Lihat program →</a>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-10 max-w-3xl rounded-2xl border border-brand-blue/15 bg-white p-6">
        <h2 class="text-xl font-semibold text-brand-deepblue">Katalog pelatihan sedang disiapkan</h2>
        <p class="mt-3 leading-relaxed text-slate-700">
          Informasi program, materi, persyaratan peserta, dan jadwal akan ditampilkan setelah masing-masing program siap dipublikasikan. Jadwal pelaksanaan akan dikelola terpisah dari informasi program agar perubahan tanggal, lokasi, kuota, dan status pendaftaran tetap akurat.
        </p>
      </div>
    )}
  </section>
</Layout>
