---
import Layout from "../../../layouts/Layout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getPublishedArticles } from "../../../data/articles";

const pageSize = 9;
const ordered = getPublishedArticles();
const pageCount = Math.ceil(ordered.length / pageSize);
export function getStaticPaths() {
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page, articles: ordered.slice((page - 1) * pageSize, page * pageSize), pageCount } };
  });
}
const { page, articles, pageCount: totalPages } = Astro.props;
---

<Layout title={`Artikel — Halaman ${page} | PT. Intiprima Sertifikasi`} description="Artikel sertifikasi, pelatihan, dan kepatuhan.">
  <section class="w-full" aria-labelledby="article-archive">
    <h1 id="article-archive" class="text-3xl font-semibold text-brand-deepblue">Artikel</h1>
    <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <nav class="mt-10 flex items-center justify-between" aria-label="Pagination">
      <a href={page === 2 ? "/articles/" : `/articles/page/${page - 1}/`} class="underline">Sebelumnya</a>
      <span aria-current="page">Halaman {page} dari {totalPages}</span>
      {page < totalPages ? <a href={`/articles/page/${page + 1}/`} class="underline">Berikutnya</a> : <span />}
    </nav>
  </section>
</Layout>
