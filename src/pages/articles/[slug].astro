---
import { getCollection } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import type { HeroBlock, PageBlock } from "../../data/pages";
import { siteCrumb } from "../../data/breadcrumbs";
import { getPublishedServices, servicePath } from "../../data/services";
import { articlePageJsonLd } from "../../lib/structured-data";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.draft !== true);
  return articles.map((entry) => {
    const pubDate = entry.data.pubDate;
    const featuredImage = entry.data.featuredImage;
    if (!(pubDate instanceof Date) || !featuredImage) {
      throw new Error(`Published article "${entry.id}" is missing its approved pubDate or featuredImage.`);
    }
    const translationPair = articles.filter(
      (candidate) => candidate.data.translationKey === entry.data.translationKey,
    );
    const alternates = translationPair.length > 1
      ? translationPair.map((candidate) => ({
          lang: candidate.data.lang,
          href: `/articles/${candidate.data.slug}/`,
        }))
      : [];
    return {
      params: { slug: entry.data.slug },
      props: { entry, alternates, pubDate, featuredImage },
    };
  });
}
const { entry, alternates, pubDate, featuredImage } = Astro.props;
const lang = entry.data.lang;
const canonical = `/articles/${entry.data.slug}/`;
const allBlocks = entry.data.blocks ?? [];
const hero = allBlocks.find((block): block is HeroBlock => block.type === "hero");
if (!hero) throw new Error(`Article "${entry.id}" is missing a hero block.`);
const blocks: PageBlock[] = allBlocks.filter((block) => block.type !== "hero");
const publishedServices = await getPublishedServices(lang === "en" ? "en" : "id");
const matchedService = entry.data.serviceId
  ? publishedServices.find((service) => service.data.id === entry.data.serviceId)
  : undefined;
if (entry.data.serviceId && !matchedService) {
  throw new Error(`Article "${entry.data.slug}" references missing or unpublished service ID "${entry.data.serviceId}".`);
}
const relatedServices = matchedService
  ? [{ name: matchedService.data.title, description: matchedService.data.metaDescription, path: servicePath(matchedService.data) }]
  : [];
const publishedTrainings = await getCollection("training", ({ data }) => data.draft !== true && data.lang === lang);
const relatedCourses = (entry.data.relatedTrainingSlugs ?? []).map((slug) => {
  const course = publishedTrainings.find((item) => item.data.slug === slug);
  if (!course) throw new Error(`Article "${entry.data.slug}" references missing or unpublished training "${slug}".`);
  return {
    name: course.data.title,
    description: course.data.metaDescription,
    path: `/trainings/${course.data.slug}/`,
  };
});
const structuredData = articlePageJsonLd({
  name: entry.data.title,
  description: entry.data.metaDescription,
  path: canonical,
  image: featuredImage.src,
  lang,
  datePublished: pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? pubDate).toISOString(),
  blocks,
  relatedServices,
  relatedCourses,
});
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.metaDescription}
  lang={entry.data.lang}
  canonical={canonical}
  ogImage={featuredImage.src}
  date={entry.data.updatedDate ?? pubDate}
  imageAlt={featuredImage.alt}
  alternates={alternates}
  breadcrumbs={[siteCrumb("/", lang), siteCrumb("/articles/", lang), { label: entry.data.title }]}
  hero={hero}
  blocks={blocks}
  structuredData={structuredData}
/>
