---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import { siteCrumb } from "../data/breadcrumbs";
import type { HeroBlock, PageBlock } from "../data/pages";
import type { SeoAlternate } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  imageAlt: string;
  footerDescription?: string;
  alternates?: SeoAlternate[];
  hero: HeroBlock;
  blocks: PageBlock[];
  structuredData?: unknown[];
}
const { title, description, lang = "id", canonical, ogImage, imageAlt, footerDescription, alternates = [], hero, blocks, structuredData = [] } = Astro.props;
const uiLang = lang === "en" ? "en" : "id";
const homeCrumb = siteCrumb("/", uiLang);
const trainingCrumb = siteCrumb("/trainings/", uiLang);
const fallbackImage = { src: ogImage ?? "", alt: imageAlt };
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} footerDescription={footerDescription} alternates={alternates} structuredData={structuredData}>
  <Fragment slot="fullBleed">
    <div class="mx-auto w-full max-w-[var(--container-landing)] px-[var(--page-gutter)] pt-8 sm:pt-10 lg:pt-12">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <Breadcrumbs items={[homeCrumb, trainingCrumb, { label: title }]} lang={uiLang} />
      </div>
    </div>
    <PageHero block={hero} fallbackImage={fallbackImage} lang={lang} isTrainings />
  </Fragment>
  <Container as="article" variant="wide" gutter={false}>
    <div class="mt-10">
      <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={lang} />
    </div>
    <slot />
  </Container>
</Layout>
