---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import type { HeroBlock, PageBlock } from "../data/pages";
import type { SeoAlternate } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  imageAlt: string;
  footerDescription?: string;
  alternates?: SeoAlternate[];
  hero: HeroBlock;
  blocks: PageBlock[];
}
const { title, description, lang = "id", canonical, ogImage, imageAlt, footerDescription, alternates = [], hero, blocks } = Astro.props;
const homeLabel = lang === "en" ? "Home" : "Beranda";
const trainingLabel = lang === "en" ? "Training" : "Pelatihan";
const fallbackImage = { src: ogImage ?? "", alt: imageAlt };
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} footerDescription={footerDescription} alternates={alternates}>
  <Fragment slot="fullBleed">
    <div class="mx-auto w-full max-w-[var(--container-landing)] px-[var(--page-gutter)] pt-8 sm:pt-10 lg:pt-12">
      <div class="mx-auto w-full max-w-[var(--container-wide)]">
        <Breadcrumbs items={[{ label: homeLabel, href: "/" }, { label: trainingLabel, href: "/trainings/" }, { label: title }]} />
      </div>
    </div>
    <PageHero block={hero} fallbackImage={fallbackImage} isTrainings />
  </Fragment>
  <Container as="article" variant="wide" gutter={false}>
    <div class="mt-10">
      <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={lang} />
    </div>
    <slot />
  </Container>
</Layout>
