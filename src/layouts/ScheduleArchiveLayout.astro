---
import Layout from "./Layout.astro";
import MainMenuHero from "../components/MainMenuHero.astro";
import Container from "../components/Container.astro";
import type { SeoAlternate } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  canonical: string;
  alternates?: SeoAlternate[];
  image: string;
  imageAlt: string;
  eyebrow?: string;
  lang?: string;
}

const {
  title,
  description,
  canonical,
  alternates,
  image,
  imageAlt,
  eyebrow = "Training Schedule",
  lang = "id",
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternates}
  lang={lang}
  ogImage={image}
>
  <Fragment slot="fullBleed">
    <MainMenuHero
      eyebrow={eyebrow}
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      variant="schedules"
    />
  </Fragment>
  <Container variant="wide" gutter={false} class="space-y-10">
    <slot />
  </Container>
</Layout>
