---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BlockRenderer, { type Block } from "../components/BlockRenderer.astro";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  imageAlt: string;
  blocks?: Block[];
  structuredData?: unknown[];
}
const { title, description, lang, canonical, ogImage, imageAlt, blocks = [], structuredData = [] } = Astro.props;
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} structuredData={structuredData}>
  <article class="mx-auto w-full max-w-[var(--container-wide)]">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Layanan", href: "/services/" }, { label: title }]} />
    {ogImage && <figure class="mb-8 max-w-5xl overflow-hidden rounded-xl border border-border bg-surface-muted">
      <img data-page-image src={ogImage} alt={imageAlt} width="1200" height="675" loading="eager" decoding="async" fetchpriority="high" class="aspect-video w-full object-cover" />
    </figure>}
    <div class="prose mt-8 max-w-3xl">
      <slot />
    </div>
    <BlockRenderer blocks={blocks} />
  </article>
</Layout>

<style>
  .prose :global(h1) {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  .prose :global(h1 + p) {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
