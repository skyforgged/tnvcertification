---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import type { HeroBlock, PageBlock } from "../data/pages";

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  imageAlt: string;
  structuredData?: unknown[];
  breadcrumbs?: Array<{ label: string; href?: string }>;
  hero: HeroBlock;
  blocks: PageBlock[];
  currentServiceId: number;
  otherServices: Array<{ id: number; title: string; description: string; href: string; category: string }>;
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage,
  imageAlt,
  structuredData = [],
  breadcrumbs = [],
  hero,
  blocks,
  currentServiceId,
  otherServices,
} = Astro.props;
const fallbackImage = { src: ogImage ?? "", alt: imageAlt };
---

<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} structuredData={structuredData}>
  <Container as="article" variant="wide" gutter={false}>
    <Breadcrumbs items={breadcrumbs} lang={lang === "en" ? "en" : "id"} />
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} />}
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-10">
      <div class="min-w-0">
        <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={lang} />
      </div>
      <aside aria-labelledby="other-services-title" class="lg:sticky lg:top-24">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="relative overflow-hidden bg-gradient-to-br from-brand-deepblue via-[#17466c] to-brand-blue px-5 py-6 text-white">
            <div aria-hidden="true" class="absolute -right-8 -top-8 h-28 w-28 rounded-full border border-white/15"></div>
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-white/70">Explore our services</p>
            <h2 id="other-services-title" class="mt-2 text-xl font-bold tracking-tight">{lang === "en" ? "Other Services" : "Layanan Lainnya"}</h2>
            <p class="mt-2 text-sm leading-relaxed text-white/80">{lang === "en" ? "Discover other certification services for your organization." : "Temukan layanan sertifikasi lain yang sesuai dengan kebutuhan organisasi."}</p>
          </div>
          <nav aria-label={lang === "en" ? "Other certification services" : "Layanan sertifikasi lainnya"} class="divide-y divide-slate-100 p-2">
            {otherServices.filter((item) => item.id !== currentServiceId).map((item) => (
              <a href={item.href} class="group flex gap-3 rounded-xl px-3 py-3.5 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-brand-blue">
                <span aria-hidden="true" class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-brand-deepblue transition-colors group-hover:bg-brand-deepblue group-hover:text-white">↗</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-snug text-ink group-hover:text-brand-deepblue">{item.title}</span>
                  <span class="mt-1 block text-xs leading-relaxed text-ink-muted">{item.category}</span>
                  <span class="mt-1.5 block line-clamp-2 text-xs leading-relaxed text-ink-subtle">{item.description}</span>
                </span>
              </a>
            ))}
          </nav>
          <div class="border-t border-slate-100 bg-slate-50 px-5 py-4">
            <p class="text-xs leading-relaxed text-ink-muted">{lang === "en" ? "Need help finding the right scheme?" : "Belum yakin standar yang sesuai?"}</p>
            <a href={lang === "en" ? "/en/contact/" : "/contact/"} class="mt-2 inline-flex items-center text-sm font-semibold text-brand-deepblue underline underline-offset-4 hover:text-brand-blue">{lang === "en" ? "Talk to our team" : "Diskusikan kebutuhan"} <span class="ml-1" aria-hidden="true">→</span></a>
          </div>
        </div>
      </aside>
    </div>
    <slot />
  </Container>
</Layout>
