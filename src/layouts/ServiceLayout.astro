---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BlockRenderer, { type Block } from "../components/BlockRenderer.astro";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  blocks?: Block[];
  structuredData?: unknown[];
}
const { title, description, lang, canonical, ogImage, blocks = [], structuredData = [] } = Astro.props;
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} structuredData={structuredData}>
  <article class="w-full">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Layanan", href: "/service/" }, { label: title }]} />
    <div class="prose mt-8 max-w-3xl">
      <slot />
    </div>
    <BlockRenderer blocks={blocks} />
  </article>
</Layout>

<style>
  .prose :global(h1) {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-brand-deepblue);
  }
  .prose :global(h1 + p) {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: #334155;
  }
</style>
