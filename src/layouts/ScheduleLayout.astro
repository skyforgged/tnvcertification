---
import Layout from "./Layout.astro";
import Container from "../components/Container.astro";
import ButtonLink from "../components/ButtonLink.astro";

interface Props {
  title: string;
  description: string;
  startDate: Date | string;
  endDate?: Date | string;
  location?: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  registrationStatus?: string;
  registrationUrl?: string;
}

const {
  title,
  description,
  startDate,
  endDate,
  location,
  lang,
  canonical,
  ogImage,
  registrationStatus,
  registrationUrl,
} = Astro.props;

function formatDate(value: Date | string): string {
  const date = value instanceof Date ? value : new Date(`${value}T00:00:00Z`);
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
}
---

<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage}>
  <Container as="article" variant="standard">
    <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h1>
    <dl class="mt-8 grid gap-6 border-y border-border py-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-ink-subtle">Mulai</dt>
        <dd class="mt-1 text-ink">
          <time datetime={String(startDate).slice(0, 10)}>{formatDate(startDate)}</time>
        </dd>
      </div>
      {endDate && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-ink-subtle">Selesai</dt>
          <dd class="mt-1 text-ink">
            <time datetime={String(endDate).slice(0, 10)}>{formatDate(endDate)}</time>
          </dd>
        </div>
      )}
      {location && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-ink-subtle">Lokasi</dt>
          <dd class="mt-1 text-ink">{location}</dd>
        </div>
      )}
      {registrationStatus && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-ink-subtle">Status</dt>
          <dd class="mt-1 text-ink">{registrationStatus}</dd>
        </div>
      )}
    </dl>
    <p class="mt-8 max-w-3xl text-lg leading-relaxed text-ink-muted">{description}</p>
    <div class="mt-8"><slot /></div>
    {registrationUrl && (
      <ButtonLink href={registrationUrl} class="mt-8">
        Daftar
      </ButtonLink>
    )}
  </Container>
</Layout>
