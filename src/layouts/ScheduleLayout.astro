---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  startDate: Date | string;
  endDate?: Date | string;
  location?: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  registrationStatus?: string;
  registrationUrl?: string;
}

const {
  title,
  description,
  startDate,
  endDate,
  location,
  lang,
  canonical,
  ogImage,
  registrationStatus,
  registrationUrl,
} = Astro.props;

function formatDate(value: Date | string): string {
  const date = value instanceof Date ? value : new Date(`${value}T00:00:00Z`);
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
}
---

<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage}>
  <article class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-semibold tracking-tight text-brand-deepblue">{title}</h1>
    <dl class="mt-8 grid gap-4 border-y-4 border-brand-mint py-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Mulai</dt>
        <dd class="mt-1 text-slate-900">
          <time datetime={String(startDate).slice(0, 10)}>{formatDate(startDate)}</time>
        </dd>
      </div>
      {endDate && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Selesai</dt>
          <dd class="mt-1 text-slate-900">
            <time datetime={String(endDate).slice(0, 10)}>{formatDate(endDate)}</time>
          </dd>
        </div>
      )}
      {location && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Lokasi</dt>
          <dd class="mt-1 text-slate-900">{location}</dd>
        </div>
      )}
      {registrationStatus && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Status</dt>
          <dd class="mt-1 text-slate-900">{registrationStatus}</dd>
        </div>
      )}
    </dl>
    <p class="mt-8 text-lg leading-relaxed text-slate-700">{description}</p>
    <div class="mt-8"><slot /></div>
    {registrationUrl && (
      <a
        href={registrationUrl}
        class="mt-8 inline-block bg-brand-orange px-5 py-2 text-sm font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-orange"
      >
        Daftar
      </a>
    )}
  </article>
</Layout>
