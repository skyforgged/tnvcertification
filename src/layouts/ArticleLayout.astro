---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  date: Date;
  imageAlt: string;
}
const { title, description, lang, canonical, ogImage, date, imageAlt } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage}>
  <article class="mx-auto w-full max-w-3xl">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Artikel", href: "/articles/" }, { label: title }]} />
    <div
      role="img"
      aria-label={imageAlt}
      class="mb-8 flex h-48 items-end bg-brand-blue/10 p-6"
    >
      <span class="text-xs font-semibold uppercase tracking-widest text-brand-deepblue">Artikel</span>
    </div>
    <p class="text-sm text-slate-500">
      <time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time>
    </p>
    <div class="prose mt-4"><slot /></div>
  </article>
</Layout>

<style>
  .prose :global(h1) {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-brand-deepblue);
  }
  .prose :global(h1 + p) {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: #334155;
  }
</style>
