---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import FeaturedImage from "../components/FeaturedImage.astro";
import type { SeoAlternate } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  date: Date;
  imageAlt: string;
  alternates?: SeoAlternate[];
}
const { title, description, lang = "id", canonical, ogImage, date, imageAlt, alternates = [] } = Astro.props;
const homeLabel = lang === "en" ? "Home" : "Beranda";
const archiveLabel = lang === "en" ? "Articles" : "Artikel";
const dateFormatter = new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} alternates={alternates}>
  <Container as="article" variant="reading" gutter={false}>
    <Breadcrumbs items={[{ label: homeLabel, href: "/" }, { label: archiveLabel, href: "/articles/" }, { label: title }]} />
    {ogImage && <FeaturedImage src={ogImage} alt={imageAlt} priority class="mb-8 mt-8" />}
    <p class="text-sm text-ink-subtle"><time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time></p>
    <div class="prose mt-4"><slot /></div>
  </Container>
</Layout>

<style>
  .prose :global(h1) {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  .prose :global(h1 + p) {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
