---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import type { SeoAlternate } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  date: Date;
  imageAlt: string;
  alternates?: SeoAlternate[];
}
const { title, description, lang = "id", canonical, ogImage, date, imageAlt, alternates = [] } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} alternates={alternates}>
  <article class="mx-auto w-full max-w-3xl">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Artikel", href: "/articles/" }, { label: title }]} />
    {ogImage && (
      <figure class="mb-8 overflow-hidden rounded-xl bg-brand-blue/10">
        <img
          src={ogImage}
          alt={imageAlt}
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="aspect-video w-full object-cover"
        />
      </figure>
    )}
    <p class="text-sm text-slate-500">
      <time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time>
    </p>
    <div class="prose mt-4"><slot /></div>
  </article>
</Layout>

<style>
  .prose :global(h1) {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-brand-deepblue);
  }
  .prose :global(h1 + p) {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: #334155;
  }
</style>
