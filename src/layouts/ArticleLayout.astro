---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import type { HeroBlock, PageBlock } from "../data/pages";
import type { SeoAlternate } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  date: Date;
  imageAlt: string;
  alternates?: SeoAlternate[];
  breadcrumbs?: Array<{ label: string; href?: string }>;
  hero: HeroBlock;
  blocks: PageBlock[];
  structuredData?: unknown[];
}
const {
  title,
  description,
  lang = "id",
  canonical,
  ogImage,
  date,
  imageAlt,
  alternates = [],
  breadcrumbs = [],
  hero,
  blocks,
  structuredData = [],
} = Astro.props;
const fallbackImage = { src: ogImage ?? "", alt: imageAlt };
const dateFormatter = new Intl.DateTimeFormat(lang === "en" ? "en-US" : "id-ID", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} alternates={alternates} structuredData={structuredData}>
  <Fragment slot="fullBleed">
    <div class="mx-auto w-full max-w-[var(--container-landing)] px-[var(--page-gutter)] pt-8 sm:pt-10 lg:pt-12">
      <div class="mx-auto w-full max-w-[var(--container-reading)]">
        <Breadcrumbs items={breadcrumbs} lang={lang === "en" ? "en" : "id"} />
      </div>
    </div>
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} isArticles />}
  </Fragment>
  <Container as="article" variant="reading" gutter={false}>
    <p class="text-sm text-ink-subtle"><time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time></p>
    <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} lang={lang} />
  </Container>
</Layout>
