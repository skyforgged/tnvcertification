---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  intro: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  date: Date;
  imageAlt: string;
}

const { title, description, intro, lang, canonical, ogImage, date, imageAlt } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage}>
  <article class="mx-auto max-w-3xl">
    <div
      role="img"
      aria-label={imageAlt}
      class="mb-8 flex h-48 items-end bg-brand-blue/10 p-6"
    >
      <span class="text-xs font-semibold uppercase tracking-widest text-brand-deepblue">Artikel</span>
    </div>
    <h1 class="text-3xl font-semibold tracking-tight text-brand-deepblue">{title}</h1>
    <p class="mt-3 text-sm text-slate-500">
      <time datetime={date.toISOString().slice(0, 10)}>{dateFormatter.format(date)}</time>
    </p>
    <p class="mt-6 text-lg leading-relaxed text-slate-700">{intro}</p>
    <div class="prose mt-8"><slot /></div>
  </article>
</Layout>
