---
import MainMenuHero from "../MainMenuHero.astro";
import ButtonLink from "../ButtonLink.astro";
import { organization, primaryNavigation, siteSettings } from "../../site";
import { navigationHref, uiLang } from "../../lib/navigation";
import type { HeroBlock } from "../../data/pages";
interface Props { block: HeroBlock; fallbackImage: { src: string; alt: string }; lang?: string; isHomepage?: boolean; isServices?: boolean; isCsms?: boolean; isTrainings?: boolean; isArticles?: boolean; }
const { block, fallbackImage, lang = "id", isHomepage = false, isServices = false, isCsms = false, isTrainings = false, isArticles = false } = Astro.props;
const ui = uiLang(lang);
const actions = siteSettings.ui.heroActions;
const whatsappNumber = organization.contact.whatsapp.replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappNumber}`;
const servicesEntry = primaryNavigation.find((item) => item.href === "/services/");
const servicesHref = servicesEntry ? navigationHref(servicesEntry, lang) : "/";
---
<div id={block.id}>
  <MainMenuHero eyebrow={block.eyebrow} title={block.title} description={block.description ?? ""} image={block.image ?? fallbackImage.src} imageAlt={block.imageAlt ?? fallbackImage.alt} imagePriority variant={isHomepage ? "home" : isServices ? "services" : isCsms ? "csms" : isTrainings ? "trainings" : isArticles ? "articles" : "default"}>
    {isHomepage && <ButtonLink slot="actions" href={whatsappHref}>{actions.whatsapp[ui]} <span aria-hidden="true">↗</span></ButtonLink>}
    {isHomepage && <ButtonLink slot="actions" href={servicesHref} variant="secondary">{actions.exploreServices[ui]}</ButtonLink>}
    {isServices && <ButtonLink slot="actions" href="#daftar-layanan">{actions.viewServiceList[ui]} <span aria-hidden="true">↓</span></ButtonLink>}
  </MainMenuHero>
</div>