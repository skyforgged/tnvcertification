---
import MainMenuHero from "../MainMenuHero.astro";
import ButtonLink from "../ButtonLink.astro";
import { organization } from "../../site";
import type { HeroBlock } from "../../data/pages";

interface Props {
  block: HeroBlock;
  fallbackImage: { src: string; alt: string };
}

const { block, fallbackImage } = Astro.props;
const whatsappNumber = organization.contact.whatsapp.replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappNumber}`;
---

<div id={block.id}>
  <MainMenuHero
    eyebrow={block.eyebrow}
    title={block.title}
    description={block.description ?? ""}
    image={block.image ?? fallbackImage.src}
    imageAlt={block.imageAlt ?? fallbackImage.alt}
    imagePriority
  >
    <ButtonLink href={whatsappHref}>
      Konsultasi via WhatsApp
      <span aria-hidden="true">↗</span>
    </ButtonLink>
    <ButtonLink href="/services/" variant="secondary">
      Jelajahi layanan
    </ButtonLink>
  </MainMenuHero>
</div>
