---
import MainMenuHero from "../MainMenuHero.astro";
import ButtonLink from "../ButtonLink.astro";
import { organization, primaryNavigation } from "../../site";
import type { HeroBlock } from "../../data/pages";
interface Props { block: HeroBlock; fallbackImage: { src: string; alt: string }; isHomepage?: boolean; isServices?: boolean; isCsms?: boolean; isTrainings?: boolean; }
const { block, fallbackImage, isHomepage = false, isServices = false, isCsms = false, isTrainings = false } = Astro.props;
const whatsappNumber = organization.contact.whatsapp.replace(/\D/g, "");
const whatsappHref = `https://wa.me/${whatsappNumber}`;
const servicesHref = primaryNavigation.find((item) => item.href === "/services/")?.href ?? "/";
---
<div id={block.id}>
  <MainMenuHero eyebrow={block.eyebrow} title={block.title} description={block.description ?? ""} image={block.image ?? fallbackImage.src} imageAlt={block.imageAlt ?? fallbackImage.alt} imagePriority variant={isHomepage ? "home" : isServices ? "services" : isCsms ? "csms" : isTrainings ? "trainings" : "default"}>
    {isHomepage && <ButtonLink slot="actions" href={whatsappHref}>Hubungi Kami via WhatsApp <span aria-hidden="true">↗</span></ButtonLink>}
    {isHomepage && <ButtonLink slot="actions" href={servicesHref} variant="secondary">Jelajahi layanan</ButtonLink>}
    {isServices && <ButtonLink slot="actions" href="#daftar-layanan">Lihat daftar layanan <span aria-hidden="true">↓</span></ButtonLink>}
  </MainMenuHero>
</div>