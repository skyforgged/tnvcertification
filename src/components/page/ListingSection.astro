---
import Section from "../Section.astro";
import type { ListingBlock } from "../../data/pages";

interface Props {
  block: ListingBlock;
  hasItems: boolean;
}

const { block, hasItems } = Astro.props;
const headingId = block.title && block.id ? `${block.id}-heading` : undefined;
const EmptyHeading = block.title ? "h3" : "h2";
const emptyTitle = block.emptyTitle;
const emptyDescription = block.emptyDescription;
---

<Section id={block.id} aria-labelledby={headingId} spacing={block.source === "articles" ? "spacious" : "default"}>
  {block.eyebrow && <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-deepblue">{block.eyebrow}</p>}
  {block.title && (
    <div class="mt-3 flex flex-col gap-4 border-b border-border pb-5 sm:flex-row sm:items-end sm:justify-between">
      <h2 id={headingId} class="max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-ink sm:text-4xl">{block.title}</h2>
      {block.description && <p class="max-w-xl text-sm leading-relaxed text-ink-muted sm:text-right">{block.description}</p>}
    </div>
  )}
  {!block.title && block.description && <p class="mt-3 max-w-3xl leading-relaxed text-ink-muted">{block.description}</p>}

  {hasItems ? (
    <div class="mt-8"><slot /></div>
  ) : (
    <div class="mt-8 max-w-3xl border-y border-border bg-surface-muted/60 px-6 py-9 sm:px-8">
      {emptyTitle && <EmptyHeading class="text-xl font-semibold tracking-tight text-ink">{emptyTitle}</EmptyHeading>}
      {emptyDescription && <p class="mt-3 leading-relaxed text-ink-muted">{emptyDescription}</p>}
      {block.emptyActionHref && block.emptyActionLabel && (
        <a href={block.emptyActionHref} class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-brand-deepblue underline underline-offset-4 hover:text-brand-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">{block.emptyActionLabel}<span aria-hidden="true">→</span></a>
      )}
    </div>
  )}

  {block.actionHref && block.actionLabel && (
    <a href={block.actionHref} class="mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-brand-deepblue underline underline-offset-4 hover:text-brand-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">{block.actionLabel}<span aria-hidden="true">→</span></a>
  )}
</Section>
