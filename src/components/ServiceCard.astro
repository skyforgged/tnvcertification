---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
}
const { title, description, href, label = "Layanan" } = Astro.props;
---
<article class="flex h-full flex-col border-t-2 border-brand-deepblue pt-5">
  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-subtle">{label}</p>
  <h2 class="mt-2 text-xl font-semibold leading-snug tracking-tight text-ink">
    <a href={href} class="rounded-sm underline-offset-4 hover:text-brand-deepblue hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">{title}</a>
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-ink-muted">{description}</p>
  <a href={href} class="mt-auto inline-flex min-h-11 items-center self-start pt-4 text-sm font-semibold text-brand-deepblue underline underline-offset-4 hover:text-brand-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue">
    Pelajari layanan <span class="ml-2" aria-hidden="true">→</span>
  </a>
</article>
