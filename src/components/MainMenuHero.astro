---
import FeaturedImage from "./FeaturedImage.astro";
import { organization, siteSettings } from "../site";
interface Props {
  eyebrow?: string; title: string; description: string; image: string; imageAlt: string;
  imagePriority?: boolean; variant?: "default" | "home";
}
const { eyebrow, title, description, image, imageAlt, imagePriority = false, variant = "default" } = Astro.props;
const isHome = variant === "home";
---
<section data-main-menu-hero class:list={[
  "grid w-full items-center border-b border-border",
  isHome ? "relative isolate gap-9 overflow-hidden pb-10 pt-7 sm:gap-12 sm:pb-14 sm:pt-10 lg:min-h-[34rem] lg:grid-cols-[minmax(0,1.02fr)_minmax(360px,0.98fr)] lg:gap-14 lg:py-14" : "gap-8 py-8 sm:gap-10 sm:py-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.95fr)] lg:gap-14 lg:py-16"
]} aria-labelledby="main-menu-hero-title">
  {isHome && <div aria-hidden="true" class="pointer-events-none absolute -left-28 top-0 -z-10 h-72 w-72 rounded-full bg-brand-blue/[0.06] blur-3xl"></div>}
  <div class="relative z-10 max-w-3xl">
    {eyebrow && <p class:list={["font-semibold uppercase text-brand-deepblue", isHome ? "mb-5 inline-flex items-center gap-2 text-[0.7rem] tracking-[0.18em] sm:text-xs" : "mb-4 text-xs tracking-[0.14em] sm:text-sm"]}>
      {isHome && <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-brand-orange"></span>}{eyebrow}
    </p>}
    <h1 id="main-menu-hero-title" class:list={["font-semibold text-ink", isHome ? "max-w-[14ch] text-[2.45rem] leading-[1.08] tracking-[-0.045em] sm:text-5xl lg:text-[3.65rem]" : "max-w-3xl text-3xl leading-[1.12] tracking-tight sm:text-4xl lg:text-5xl"]}>{title}</h1>
    <p class:list={["text-ink-muted", isHome ? "mt-6 max-w-[42rem] text-base leading-[1.8] sm:text-lg" : "mt-5 max-w-2xl text-base leading-relaxed sm:text-lg"]}>{description}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"><slot name="actions" /></div>
    {isHome && <p class="mt-7 flex items-center gap-3 text-xs font-medium tracking-wide text-ink-subtle"><span aria-hidden="true" class="h-px w-8 bg-brand-orange"></span>{organization.name} · {siteSettings.tagline}</p>}
  </div>
  <div class:list={["relative mx-auto w-full", isHome ? "max-w-[38rem] lg:ml-auto" : ""]}>
    {isHome && <div aria-hidden="true" class="absolute -right-4 -top-4 h-24 w-24 border-r-2 border-t-2 border-brand-orange/70 sm:-right-5 sm:-top-5 sm:h-32 sm:w-32"></div>}
    <div class:list={["relative z-10", isHome ? "overflow-hidden rounded-[1.15rem] border border-white bg-white p-2 shadow-[0_24px_70px_-34px_rgba(23,54,168,0.42)] sm:rounded-[1.5rem] sm:p-3" : ""]}>
      <FeaturedImage src={image} alt={imageAlt} width={1200} height={900} aspect="fourThree" priority={imagePriority} class={isHome ? "rounded-[0.85rem] border-0 sm:rounded-[1.1rem]" : "relative w-full"} />
    </div>
    {isHome && <div aria-hidden="true" class="absolute -bottom-5 -left-5 -z-10 h-28 w-28 rounded-full border-[14px] border-brand-blue/[0.08] sm:-bottom-7 sm:-left-7 sm:h-36 sm:w-36"></div>}
  </div>
</section>