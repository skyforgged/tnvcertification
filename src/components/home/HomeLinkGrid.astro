---
import Section from "../Section.astro";
import type { LinkGridBlock } from "../../data/pages";
interface Props { block: LinkGridBlock; }
const { block } = Astro.props;
const headingId = block.title && block.id ? `${block.id}-heading` : undefined;
---
<Section id={block.id} aria-labelledby={headingId} spacing="spacious" class="relative">
  {block.eyebrow && <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-deepblue">{block.eyebrow}</p>}
  {block.title && <div class="mt-3 flex flex-col gap-4 border-b border-border pb-5 sm:flex-row sm:items-end sm:justify-between">
    <h2 id={headingId} class="max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-ink sm:text-4xl">{block.title}</h2>
    <span aria-hidden="true" class="hidden text-sm font-medium text-ink-subtle sm:block">Temukan kebutuhan Anda <span class="text-brand-orange">→</span></span>
  </div>}
  <div class="mt-2 grid gap-x-8 sm:grid-cols-2">
    {block.items.map((item, index) => <a href={item.href} class="group relative flex min-h-48 flex-col border-b border-border py-7 transition-colors duration-200 hover:bg-surface-muted/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-brand-blue">
      <span class="flex items-center justify-between">
        {item.eyebrow && <span class="text-[0.68rem] font-bold uppercase tracking-[0.15em] text-ink-subtle">{item.eyebrow}</span>}
        <span class="ml-auto text-sm font-semibold tabular-nums text-ink-subtle">0{index + 1}</span>
      </span>
      <h3 class="mt-4 max-w-lg text-xl font-semibold tracking-tight text-ink transition-colors group-hover:text-brand-deepblue sm:text-2xl">{item.title}</h3>
      {item.description && <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-muted">{item.description}</p>}
      {item.actionLabel && <span class="mt-auto inline-flex min-h-11 items-center gap-2 pt-4 text-sm font-semibold text-brand-deepblue">{item.actionLabel}<span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span></span>}
    </a>)}
  </div>
</Section>