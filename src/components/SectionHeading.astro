---
type HeadingLevel = 2 | 3;
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  level?: HeadingLevel;
  class?: string;
}
const { title, id, eyebrow, level = 2, class: className = "" } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---
<div class:list={["max-w-3xl", className]}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-subtle">{eyebrow}</p>}
  <Heading id={id} class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">{title}</Heading>
</div>
