---
interface FaqBlock {
  type: "faq";
  items: Array<{ question: string; answer: string }>;
}

interface HowToBlock {
  type: "howto";
  steps: Array<{
    title: string;
    description: string;
    image?: { src: string; alt: string; caption?: string };
  }>;
}

interface CtaBlock {
  type: "cta";
  variant?: "primary" | "secondary" | "ghost";
  title?: string;
  description?: string;
  link?: { label: string; url: string };
}

export type Block = FaqBlock | HowToBlock | CtaBlock;

interface Props {
  blocks?: Block[];
}

const { blocks = [] } = Astro.props;

const ctaClass = (variant?: CtaBlock["variant"]) =>
  variant === "secondary"
    ? "border border-brand-deepblue bg-white text-brand-deepblue hover:bg-surface-muted"
    : variant === "ghost"
      ? "text-brand-deepblue underline decoration-brand-blue underline-offset-4 hover:text-brand-blue"
      : "bg-brand-deepblue text-white hover:bg-brand-blue";
---

<div class="space-y-12">
  {blocks.map((block) =>
    block.type === "faq" ? (
      <section class="border-t border-border pt-8" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight text-ink">Pertanyaan Umum</h2>
        <dl class="mt-6 divide-y divide-border">
          {block.items.map((item) => (
            <div class="py-5 first:pt-0 last:pb-0">
              <dt class="font-semibold text-ink">{item.question}</dt>
              <dd class="mt-2 max-w-[var(--container-reading)] leading-relaxed text-ink-muted">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    ) : block.type === "howto" ? (
      <section class="border-t border-border pt-8" aria-labelledby="howto-heading">
        <h2 id="howto-heading" class="text-2xl font-semibold tracking-tight text-ink">Langkah Pelaksanaan</h2>
        <ol class="mt-6 divide-y divide-border">
          {block.steps.map((step, index) => (
            <li class="grid gap-3 py-5 first:pt-0 sm:grid-cols-[3rem_minmax(0,1fr)]">
              <span class="text-sm font-semibold tabular-nums text-ink-subtle">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="text-lg font-semibold text-ink">{step.title}</h3>
                <p class="mt-2 max-w-[var(--container-reading)] leading-relaxed text-ink-muted">{step.description}</p>
                {step.image && (
                  <figure class="mt-5 max-w-2xl">
                    <img
                      src={step.image.src}
                      alt={step.image.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-auto w-full rounded-[var(--radius-panel)] object-cover"
                    />
                    {step.image.caption && <figcaption class="mt-2 text-sm text-ink-subtle">{step.image.caption}</figcaption>}
                  </figure>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <aside class="border-y border-border bg-surface-muted px-6 py-7 sm:px-8" aria-label={block.title ?? "Informasi selanjutnya"}>
        {block.title && <h2 class="text-xl font-semibold tracking-tight text-ink">{block.title}</h2>}
        {block.description && <p class="mt-2 max-w-[var(--container-reading)] leading-relaxed text-ink-muted">{block.description}</p>}
        {block.link && (
          <a
            href={block.link.url}
            class={`mt-5 inline-flex min-h-11 items-center justify-center rounded-[var(--radius-control)] px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue ${ctaClass(block.variant)}`}
          >
            {block.link.label}
          </a>
        )}
      </aside>
    ),
  )}
</div>
