---
import { blockAnchorId, type BlockAnchorSource } from "../lib/block-ids";

interface SurfaceStyles {
  section: string;
  heading: string;
  body: string;
  divider: string;
}
type Surface = "white" | "blue" | "navy" | "mint" | "coral" | "cream";
const surfaces: Record<Surface, SurfaceStyles> = {
  white: {
    section: "border-block-white-line bg-block-white",
    heading: "text-block-white-heading",
    body: "text-block-white-body",
    divider: "divide-block-white-divider",
  },
  blue: {
    section: "border-block-blue-line bg-block-blue",
    heading: "text-block-blue-heading",
    body: "text-block-blue-body",
    divider: "divide-block-blue-divider",
  },
  navy: {
    section: "border-block-navy-line bg-block-navy",
    heading: "text-block-navy-heading",
    body: "text-block-navy-body",
    divider: "divide-block-navy-divider",
  },
  mint: {
    section: "border-block-mint-line bg-block-mint",
    heading: "text-block-mint-heading",
    body: "text-block-mint-body",
    divider: "divide-block-mint-divider",
  },
  coral: {
    section: "border-block-coral-line bg-block-coral",
    heading: "text-block-coral-heading",
    body: "text-block-coral-body",
    divider: "divide-block-coral-divider",
  },
  cream: {
    section: "border-block-cream-line bg-block-cream",
    heading: "text-block-cream-heading",
    body: "text-block-cream-body",
    divider: "divide-block-cream-divider",
  },
};

interface BlockBase extends BlockAnchorSource {
  surface?: Surface;
}
interface ContentSectionBlock extends BlockBase {
  type: "content-section";
  title: string;
  eyebrow?: string;
  description?: string;
  items?: Array<{ title: string; description: string }>;
}
interface FaqBlock extends BlockBase {
  type: "faq";
  items: Array<{ question: string; answer: string }>;
}
interface HowToBlock extends BlockBase {
  type: "howto";
  steps: Array<{
    title: string;
    description: string;
    image?: { src: string; alt: string; caption?: string };
  }>;
}
interface CtaBlock extends BlockBase {
  type: "cta";
  variant?: "primary" | "secondary" | "ghost";
  title?: string;
  description?: string;
  link?: { label: string; url: string };
}
export type Block = ContentSectionBlock | FaqBlock | HowToBlock | CtaBlock;
interface Props {
  blocks?: Block[];
  lang?: string;
}
const { blocks = [], lang = "id" } = Astro.props;
const faqHeading = lang === "en" ? "Frequently asked questions" : "Pertanyaan Umum";
const howToHeading = lang === "en" ? "Certification process" : "Proses Sertifikasi";
const ctaHeading = lang === "en" ? "Certification information" : "Informasi sertifikasi";
const palette: Surface[] = ["blue", "mint", "cream", "coral", "white", "navy"];
const ctaClass = (variant?: CtaBlock["variant"], surface?: Surface) =>
  variant === "secondary"
    ? "border border-current bg-transparent text-current hover:bg-black/5"
    : variant === "ghost"
      ? "text-current underline decoration-current underline-offset-4 hover:opacity-75"
      : surface === "navy"
        ? "bg-white text-brand-deepblue hover:bg-blue-50"
        : "bg-brand-deepblue text-white hover:bg-brand-deepblue-hover";
---
<div class="space-y-10 sm:space-y-14">
  {blocks.map((block, index) => {
    const surface = block.surface ?? palette[index % palette.length] ?? "white";
    const style = surfaces[surface];
    const id = blockAnchorId(block, index);
    const semanticClasses = ["block-section", `block-section--${block.type}`, `block-section--surface-${surface}`];
    return block.type === "content-section" ? (
      <section id={id} aria-labelledby={`${id}-heading`} class:list={[...semanticClasses, style.section]}>
        {block.eyebrow && <p class:list={["text-xs font-bold uppercase tracking-[0.16em]", style.body]}>{block.eyebrow}</p>}
        <h2 id={`${id}-heading`} class:list={["mt-2 text-2xl font-semibold tracking-tight sm:text-3xl", style.heading]}>{block.title}</h2>
        {block.description && <p class:list={["mt-4 max-w-[var(--container-reading)] leading-relaxed", style.body]}>{block.description}</p>}
        {block.items && (
          <ul class:list={["mt-7 grid gap-x-10 gap-y-6 sm:grid-cols-2", style.divider]}>
            {block.items.map((item, itemIndex) => (
              <li class:list={["border-t pt-4", style.divider.replace("divide-", "border-")]}>
                <span class:list={["text-xs font-bold tabular-nums", style.body]}>{String(itemIndex + 1).padStart(2, "0")}</span>
                <h3 class:list={["mt-2 text-lg font-semibold", style.heading]}>{item.title}</h3>
                <p class:list={["mt-2 leading-relaxed", style.body]}>{item.description}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ) : block.type === "faq" ? (
      <section id={id} aria-label={faqHeading} aria-labelledby={`${id}-heading`} class:list={[...semanticClasses, style.section]}>
        <h2 id={`${id}-heading`} class:list={["text-2xl font-semibold tracking-tight sm:text-3xl", style.heading]}>{faqHeading}</h2>
        <dl class:list={["mt-6 divide-y", style.divider]}>
          {block.items.map((item) => (
            <div class="py-5 first:pt-0 last:pb-0">
              <dt class:list={["font-semibold", style.heading]}>{item.question}</dt>
              <dd class:list={["mt-2 max-w-[var(--container-reading)] leading-relaxed", style.body]}>{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    ) : block.type === "howto" ? (
      <section id={id} aria-label={howToHeading} aria-labelledby={`${id}-heading`} class:list={[...semanticClasses, style.section]}>
        <h2 id={`${id}-heading`} class:list={["text-2xl font-semibold tracking-tight sm:text-3xl", style.heading]}>{howToHeading}</h2>
        <ol class:list={["mt-6 divide-y", style.divider]}>
          {block.steps.map((step, stepIndex) => (
            <li class="grid gap-3 py-5 first:pt-0 sm:grid-cols-[3rem_minmax(0,1fr)]">
              <span class:list={["text-sm font-semibold tabular-nums", style.body]}>{String(stepIndex + 1).padStart(2, "0")}</span>
              <div>
                <h3 class:list={["text-lg font-semibold", style.heading]}>{step.title}</h3>
                <p class:list={["mt-2 max-w-[var(--container-reading)] leading-relaxed", style.body]}>{step.description}</p>
                {step.image && (
                  <figure class="mt-5 max-w-2xl">
                    <img src={step.image.src} alt={step.image.alt} loading="lazy" decoding="async" class="h-auto w-full object-cover" />
                    {step.image.caption && <figcaption class:list={["mt-2 text-sm", style.body]}>{step.image.caption}</figcaption>}
                  </figure>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <aside id={id} aria-label={block.title ?? ctaHeading} aria-labelledby={`${id}-heading`} class:list={[...semanticClasses, style.section]}>
        {block.title ? (
          <h2 id={`${id}-heading`} class:list={["text-xl font-semibold tracking-tight sm:text-2xl", style.heading]}>{block.title}</h2>
        ) : (
          <h2 id={`${id}-heading`} class="sr-only">{ctaHeading}</h2>
        )}
        {block.description && <p class:list={["mt-2 max-w-[var(--container-reading)] leading-relaxed", style.body]}>{block.description}</p>}
        {block.link && (
          <a href={block.link.url} class:list={["mt-5 inline-flex min-h-11 items-center justify-center px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue", ctaClass(block.variant, surface)]}>
            {block.link.label}
          </a>
        )}
      </aside>
    );
  })}
</div>
