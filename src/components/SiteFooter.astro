---
import { organization, siteSettings, footerNavigation, primaryNavigation } from "../site";
import { navigationHref, navigationLabel, uiLang } from "../lib/navigation";

interface Props { lang: string; description?: string; }

const { lang, description } = Astro.props;
const ui = uiLang(lang);
const footerDescription = description ?? siteSettings.ui.footerDescription[ui];
---
<footer class="mt-auto border-t border-[#24436c] bg-[#0b1f3a] text-white">
  <div class="mx-auto grid max-w-[var(--content-wide)] gap-10 px-[var(--page-gutter)] py-12 md:grid-cols-[minmax(0,1.4fr)_1fr_1fr] md:py-14">
    <div class="max-w-md">
      <a href={navigationHref(primaryNavigation[0], lang)} class="inline-flex rounded-sm text-lg font-bold tracking-tight text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-orange">
        {organization.name}
      </a>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">{footerDescription}</p>
    </div>
    {footerNavigation.map((group) => (
      <nav aria-label={navigationLabel({ label: group.title, labelEn: group.titleEn }, lang)}>
        <h2 class="text-sm font-semibold text-white">{navigationLabel({ label: group.title, labelEn: group.titleEn }, lang)}</h2>
        <ul class="mt-3 space-y-2">
          {group.links.map((link) => (
            <li>
              <a href={navigationHref(link, lang)} class="text-sm text-slate-300 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-orange">
                {navigationLabel(link, lang)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-[var(--content-wide)] flex-wrap items-center justify-between gap-3 px-[var(--page-gutter)] py-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} {organization.name}.</p>
      <a href="#top" class="font-medium text-slate-200 underline underline-offset-4 transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-orange">{siteSettings.ui.backToTop[ui]}</a>
    </div>
  </div>
</footer>