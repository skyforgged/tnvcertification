---
import { organization, siteSettings, footerNavigation } from "../site";
---
<footer class="mt-auto border-t border-brand-blue/15 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[minmax(0,1.4fr)_1fr_1fr]">
    <div class="max-w-md">
      <a href="/" class="inline-flex rounded-sm text-lg font-bold tracking-tight text-brand-deepblue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue">
        {organization.name}
      </a>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">{siteSettings.description}</p>
    </div>
    {footerNavigation.map((group) => (
      <nav aria-label={group.title}>
        <h2 class="text-sm font-semibold text-slate-900">{group.title}</h2>
        <ul class="mt-3 space-y-2">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-600 underline-offset-4 hover:text-brand-blue hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-brand-blue/10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4 text-xs text-slate-500 sm:px-6">
      <p>© {new Date().getFullYear()} {organization.name}.</p>
      <a href="#top" class="font-medium text-brand-deepblue underline underline-offset-4 hover:text-brand-blue focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">Kembali ke atas ↑</a>
    </div>
  </div>
</footer>
