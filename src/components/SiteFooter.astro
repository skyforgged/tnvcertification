---
import { organization, siteSettings, footerNavigation } from "../site";
import { navigationLabel, uiLang } from "../lib/navigation";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const ui = uiLang(lang);
---
<footer class="mt-auto border-t border-border bg-white">
  <div class="mx-auto grid max-w-[var(--content-wide)] gap-10 px-[var(--page-gutter)] py-10 md:grid-cols-[minmax(0,1.4fr)_1fr_1fr]">
    <div class="max-w-md">
      <a href="/" class="inline-flex rounded-sm text-lg font-bold tracking-tight text-brand-deepblue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue">
        {organization.name}
      </a>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">{siteSettings.description}</p>
    </div>
    {footerNavigation.map((group) => (
      <nav aria-label={navigationLabel({ label: group.title, labelEn: group.titleEn }, lang)}>
        <h2 class="text-sm font-semibold text-ink">{navigationLabel({ label: group.title, labelEn: group.titleEn }, lang)}</h2>
        <ul class="mt-3 space-y-2">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-muted underline-offset-4 hover:text-brand-blue hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">
                {navigationLabel(link, lang)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-border">
    <div class="mx-auto flex max-w-[var(--content-wide)] flex-wrap items-center justify-between gap-3 px-[var(--page-gutter)] py-4 text-xs text-ink-subtle">
      <p>© {new Date().getFullYear()} {organization.name}.</p>
      <a href="#top" class="font-medium text-brand-deepblue underline underline-offset-4 hover:text-brand-blue focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue">{siteSettings.ui.backToTop[ui]}</a>
    </div>
  </div>
</footer>
