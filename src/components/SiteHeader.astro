---
import { organization, siteSettings, primaryNavigation } from "../site";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/services/") {
    return currentPath === href || currentPath.startsWith("/services/");
  }
  return currentPath === href || currentPath.startsWith(href);
};
---
<header class="border-b border-brand-blue/15 bg-cream">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 sm:px-6 md:flex-row md:items-center md:justify-between">
    <a href="/" class="group flex items-center gap-3 rounded-sm text-brand-deepblue focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue" aria-label={`${organization.name} — beranda`}>
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-blue text-sm font-bold text-white" aria-hidden="true">IP</span>
      <span class="leading-tight">
        <span class="block text-base font-bold tracking-tight">{organization.shortName}</span>
        <span class="block text-xs text-slate-600">{siteSettings.tagline}</span>
      </span>
    </a>
    <nav aria-label="Navigasi utama">
      <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold">
        {primaryNavigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "inline-flex rounded-full px-4 py-2 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue",
                isCurrent(item.href) ? "bg-brand-blue text-white" : "text-slate-700 hover:bg-brand-blue/8 hover:text-brand-deepblue",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
